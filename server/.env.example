# Rename this file to ".env" and fill in your OWN keys.
# NEVER commit the real .env file to GitHub or share it anywhere.

GITHUB_TOKEN=your_github_fine_grained_token_here
GEMINI_API_KEY=your_gemini_api_key_here
PORT=5000

# PostgreSQL connection string (create an empty database first, Prisma creates the
# tables). Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/ai_github_agent

# GitHub OAuth App credentials (create one at https://github.com/settings/developers).
# Use a separate OAuth App for production vs. local dev, since each app only
# supports one Authorization callback URL.
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# Random long string used to sign login sessions (e.g. `openssl rand -hex 32`).
JWT_SECRET=your_random_jwt_secret

# Where the frontend is hosted — used to redirect back after GitHub login.
CLIENT_URL=http://localhost:5173

# This backend's own public URL — only needed in production (e.g. Render).
# Leave unset locally; it defaults to http://localhost:<PORT>.
# SERVER_URL=https://your-app.onrender.com

# Self-tracked assumed daily request cap shown in Settings (Gemini's API doesn't
# expose real remaining quota) — set to match your actual AI Studio/Cloud plan limit.
DAILY_REQUEST_LIMIT=1500
