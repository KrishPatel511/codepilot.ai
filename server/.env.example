# Rename this file to ".env" and fill in your OWN keys.
# NEVER commit the real .env file to GitHub or share it anywhere.

GITHUB_TOKEN=your_github_fine_grained_token_here
GEMINI_API_KEY=your_gemini_api_key_here
PORT=5000

# Self-tracked assumed daily request cap shown in Settings (Gemini's API doesn't
# expose real remaining quota) — set to match your actual AI Studio/Cloud plan limit.
DAILY_REQUEST_LIMIT=1500
